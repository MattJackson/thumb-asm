endstreamendobj8284 0 obj<</CropBox[0 0 540 648]/Annots[8285 0 R 8286 0 R 8287 0 R 8288 0 R 8289 0 R 8290 0 R 8291 0 R 8292 0 R 8293 0 R 8294 0 R 8295 0 R 8296 0 R 8297 0 R 8298 0 R]/Parent 34024 0 R/B[35063 0 R]/Contents 8299 0 R/Rotate 0/MediaBox[0 0 540 648]/Thumb 19523 0 R/Resources<</Font<</T1_0 16547 0 R/T1_1 16548 0 R/T1_2 16554 0 R/T1_3 16551 0 R/T1_4 16566 0 R/T1_5 16561 0 R>>/ProcSet[/PDF/Text]/ExtGState<</GS0 36312 0 R>>>>/Type/Page>>endobj8285 0 obj<</Rect[118.98 509.58 285.54 519.6]/Subtype/Link/Border[0 0 0]/Dest(E17.CBHDJHJD)/Type/Annot>>endobj8286 0 obj<</Rect[118.98 496.62 285.54 506.64]/Subtype/Link/Border[0 0 0]/Dest(E18.Cacbggcebgg)/Type/Annot>>endobj8287 0 obj<</Rect[118.98 465.6 399.06 475.62]/Subtype/Link/Border[0 0 0]/Dest(E17.CBHCCDHA)/Type/Annot>>endobj8288 0 obj<</Rect[118.98 441.6 394.56 451.62]/Subtype/Link/Border[0 0 0]/Dest(E18.Beieeibg)/Type/Annot>>endobj8289 0 obj<</Rect[118.98 213.6 399.06 223.62]/Subtype/Link/Border[0 0 0]/Dest(E17.CBHCCDHA)/Type/Annot>>endobj8290 0 obj<</Rect[118.98 189.6 394.56 199.62]/Subtype/Link/Border[0 0 0]/Dest(E18.Beieeibg)/Type/Annot>>endobj8291 0 obj<</Rect[91.9849 533.03 387.171 544.329]/CreationDate(D:20081111164323Z)/NM(ef44c7d2-2472-4451-9332-a15d00507663)/Subtype/StrikeOut/C[0.0 0.0 1.0]/F 132/IT/StrikeOutTextEdit/M(D:20081124154519Z)/P 8284 0 R/T(ARM_2008_Q4)/Subj(Cross-Out)/QuadPoints[94.98 543.701 384.176 543.701 94.98 533.657 384.176 533.657]/IRT 8293 0 R/RT/Group/Type/Annot/Popup 8292 0 R/AP<</N 17516 0 R>>>>endobj8292 0 obj<</Rect[540.0 423.701 720.0 543.701]/Subtype/Popup/Parent 8291 0 R/F 28/Open false/Type/Annot>>endobj8293 0 obj<</Rect[380.108 533.105 388.244 539.734]/CreationDate(D:20081111164323Z)/NM(661cd9f5-a926-4185-b5c7-e8fefcbdda0f)/Subtype/Caret/C[0.0 0.0 1.0]/F 132/Contents(These values enable efficient invalidation of a range of addresses, because this value is the most efficient address stride to use to apply a sequence of address-based maintenance operations to a range of addresses.\r\rFor the Invalidate data or unified c\ache line by MVA operation, the Cache Writeback Granule field of the Cache Type Register defines the maximum granule that a single invalidate instruction can invalidate. This meaning of the Cache Writeback Granule is in addition to its defining the maximu\m size that can be written back.\r\r)/M(D:20081124154519Z)/IT/Replace/P 8284 0 R/T(ARM_2008_Q4)/Subj(Replacement Text)/RC(<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:8.0.0" xfa:spec="2.0.2" ><p dir="ltr"><span dir="ltr" style="font-size:10.0pt;text-align:left;color:#000000;font-we\ight:normal;font-style:normal">These values enable efficient invalidation of a range of addresses, because this value is the most efficient address stride to use to apply a sequence of address-based maintenance operations to a range of addresses.&#13;&#13\;For the Invalidate data or unified cache line by MVA operation, the Cache Writeback Granule field of the Cache Type Register defines the maximum granule that a single invalidate instruction can invalidate. This meaning of the Cache Writeback Granule is i\n addition to its defining the maximum size that can be written back</span><span dir="ltr" style="font-size:10.0pt;text-align:left;color:#000000;font-weight:bold;font-style:normal">.&#13;&#13;</span></p></body>)/RD[0.552399 0.552368 0.552399 0.552429]/Type/Annot/Popup 8294 0 R/AP<</N 17518 0 R>>>>endobj8294 0 obj<</Rect[248.683 404.202 428.682 523.983]/Subtype/Popup/Parent 8293 0 R/F 28/Open false/Type/Annot>>endobj8295 0 obj<</Rect[487.433 528.908 507.433 546.908]/CreationDate(D:20081111164718Z)/NM(a2dd82cb-341e-4d81-956a-0ffc5529a59b)/Subtype/Text/CA 0.505005/C[1.0 1.0 0.0]/F 156/Contents(This change is a clarification of the use of this value. It is not a change to the architecture.)/M(D:20090305102735Z)/Name/Comment/P 8284 0 R/T(ARM_2008_Q4)/Subj(Sticky Note)/RC(<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:8.0.0" xfa:spec="2.0.2" ><p dir="ltr"><span dir="ltr" style="font-size:10.0pt;text-align:left;color:#000000;font-we\ight:normal;font-style:normal">This change is a clarification of the use of this value. It is not a change to the architecture.</span></p></body>)/Type/Annot/Popup 8296 0 R/AP<</N 17519 0 R>>>>endobj8296 0 obj<</Rect[540.0 426.259 720.0 546.259]/Subtype/Popup/Parent 8295 0 R/F 28/Open false/Type/Annot>>endobj8297 0 obj<</CreationDate(D:20110203184836Z)/Rect[454.504 93.1443 474.504 111.144]/NM(74e3c6ff-cd61-420e-a8e9-bd80ac128585)/Subtype/Text/CA 0.505005/C[1.0 1.0 0.0]/F 28/Contents(The cache maintenance operation is likely to be faster if the following code is used instead of that shown:\r    MRC p15, 1, R0, c0, c0, 1     ; Read CLIDR into R0\r    ANDS R3, R0, #&7000000\r    MOV R3, R3, LSR #23          ; Cache level value \(natural\ly aligned\)\r    BEQ Finished\r    MOV R10, #0\rLoop1 \r    ADD R2, R10, R10, LSR #1   ; Work out 3 x cachelevel\r    MOV R1, R0, LSR R2            ; bottom 3 bits are the Cache type for this level\r    AND R1, R1, #7                   ; get those 3 bits\ alone\r    CMP R1, #2\r    BLT Skip                             ; no cache or only instruction cache at this level\r    MCR p15, 2, R10, c0, c0, 0   ; write CSSELR from R10\r    ISB                                    ; ISB to sync the change to the CCSID\R\r    MRC p15, 1, R1, c0, c0, 0     ; read current CCSIDR to R1\r    AND R2, R1, #&7                 ; extract the line length field\r    ADD R2, R2, #4                   ; add 4 for the line length offset \(log2 16 bytes\)\r    LDR R4, =0x3FF\r    ANDS \R4, R4, R1, LSR #3     ; R4 is the max number on the way size \(right aligned\)\r    CLZ R5, R4                          ; R5 is the bit position of the way size increment\r    MOV R9, R4                        ; R9 working copy of the max way size \(righ\t aligned\)\rLoop2 \r    LDR R7, =0x00007FFF\r    ANDS R7, R7, R1, LSR #13   ; R7 is the max number of the index size \(right aligned\)\rLoop3 \r    ORR R11, R10, R9, LSL R5    ; factor in the way number and cache number into R11\r    ORR R11, R11, R7, LS\L R2    ; factor in the index number\r    MCR p15, 0, R11, c7, c10, 2  ; DCCSW, clean by set/way\r    SUBS R7, R7, #1                  ; decrement the index\r    BGE Loop3\r    SUBS R9, R9, #1                  ; decrement the way number\r    BGE Loop2\r\r\Skip \r    ADD R10, R10, #2                ; increment the cache number\r    CMP R3, R10\r    BGT Loop1\r    DSB\rFinished)/M(D:20110712122058+01'00')/Name/Comment/P 8284 0 R/T(ghawes)/Subj(Sticky Note)/RC(<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:8.3.0" xfa:spec="2.0.2" ><p dir="ltr"><span dir="ltr" style="font-size:10.0pt;text-align:left;color:#000000;font-we\ight:normal;font-style:normal">The cache maintenance operation is likely to be faster if the following code is used instead of that shown:&#13;    MRC p15, 1, R0, c0, c0, 1     ; Read CLIDR into R0&#13;    ANDS R3, R0, #&amp;7000000&#13;    MOV R3, R3, LS\R #23          ; Cache level value \(naturally aligned\)&#13;    BEQ Finished&#13;    MOV R10, #0&#13;Loop1 &#13;    ADD R2, R10, R10, LSR #1   ; Work out 3 x cachelevel&#13;    MOV R1, R0, LSR R2            ; bottom 3 bits are the Cache type for this lev\el&#13;    AND R1, R1, #7                   ; get those 3 bits alone&#13;    CMP R1, #2&#13;    BLT Skip                             ; no cache or only instruction cache at this level&#13;    MCR p15, 2, R10, c0, c0, 0   ; write CSSELR from R10&#13;    IS\B                                    ; ISB to sync the change to the CCSIDR&#13;    MRC p15, 1, R1, c0, c0, 0     ; read current CCSIDR to R1&#13;    AND R2, R1, #&amp;7                 ; extract the line length field&#13;    ADD R2, R2, #4               \    ; add 4 for the line length offset \(log2 16 bytes\)&#13;    LDR R4, =0x3FF&#13;    ANDS R4, R4, R1, LSR #3     ; R4 is the max number on the way size \(right aligned\)&#13;    CLZ R5, R4                          ; R5 is the bit position of the way si\ze increment&#13;    MOV R9, R4                        ; R9 working copy of the max way size \(right aligned\)&#13;Loop2 &#13;    LDR R7, =0x00007FFF&#13;    ANDS R7, R7, R1, LSR #13   ; R7 is the max number of the index size \(right aligned\)&#13;Loop3 &\#13;    ORR R11, R10, R9, LSL R5    ; factor in the way number and cache number into R11&#13;    ORR R11, R11, R7, LSL R2    ; factor in the index number&#13;    MCR p15, 0, R11, c7, c10, 2  ; DCCSW, clean by set/way&#13;    SUBS R7, R7, #1               \   ; decrement the index&#13;    BGE Loop3&#13;    SUBS R9, R9, #1                  ; decrement the way number&#13;    BGE Loop2&#13;&#13;Skip &#13;    ADD R10, R10, #2                ; increment the cache number&#13;    CMP R3, R10&#13;    BGT Loop1&#13;\    DSB&#13;Finished</span></p></body>)/Type/Annot/Popup 8298 0 R/AP<</N 17517 0 R>>>>endobj8298 0 obj<</Rect[28.9173 118.805 452.408 449.351]/Subtype/Popup/Parent 8297 0 R/F 28/Open false/Type/Annot>>endobj8299 0 obj<</Length 2389/Filter/FlateDecode>>stream

 the interpretation of the arguments.&#13;</span><span dir="ltr" style="font-size:10.0pt;text-align:left;color:#000000;font-weight:normal;font-style:normal">&#13;// Rema\ppedTEXDecode\(\)&#13;// ===================&#13;&#13;MemoryAttributes RemappedTEXDecode\(bits\(5\) texcb, bit S\)&#13;&#13;    MemoryAttributes memattrs;&#13;    region = UInt\(texcb&lt;2:0&gt;\);  // texcb&lt;4:3&gt; are ignored in this mapping scheme&#\13;    if region == 6 then&#13;        IMPLEMENTATION_DEFINED setting of memattrs;&#13;    else&#13;        case PRRR&lt;\(2*region+1\):2*region&gt; of&#13;            when &#8216;00&#8217;&#13;                memattrs.type = MemType_StronglyOrdered;&#13;\                memattrs.innerattrs = &#8216;00&#8217;;  // Non-cacheable&#13;                memattrs.outerattrs = &#8216;00&#8217;;  // Non-cacheable&#13;                memattrs.shareable = TRUE;&#13;                memattrs.outershareable = TRUE;&#13;\            when &#8216;01&#8217;&#13;                memattrs.type = MemType_Device;&#13;                memattrs.innerattrs = &#8216;00&#8217;;  // Non-cacheable&#13;                memattrs.outerattrs = &#8216;00&#8217;;  // Non-cacheable&#13;         \       s_bit = if S == &#8216;0&#8217; then PRRR.DS0 else PRRR.DS1;&#13;                memattrs.shareable = \(s_bit == &#8216;1&#8217;\);&#13;                memattrs.outershareable = memattrs.shareable;&#13;            when &#8216;10&#8217;&#13;        \        memattrs.type = MemType_Normal;&#13;                memattrs.innerattrs = NMRR&lt;\(2*region+1\):2*region&gt;;&#13;                memattrs.outerattrs = NMRR&lt;\(2*region+17\):\(2*region+16\)&gt;;&#13;                s_bit = if S == &#8216;0&#821\7; then PRRR.NS0 else PRRR.NS1;&#13;                memattrs.shareable = \(s_bit == &#8216;1&#8217;\);&#13;                memattrs.outershareable = \(s_bit == &#8216;1&#8217;\) &amp;&amp; \(PRRR&lt;region+24&gt; == &#8216;1&#8217;\);&#13;            when\ &#8216;11&#8217;&#13;                UNPREDICTABLE;&#13;&#13;    return memattrs;&#13;</span></p></body>)/RD[0.492828 0.492828 0.492828 0.492828]/Type/Annot/Popup 10175 0 R/AP<</N 17790 0 R>>>>endobj10175 0 obj<</Rect[102.147 -97.4004 597.639 250.164]/Subtype/Popup/Parent 10174 0 R/F 28/Open false/Type/Annot>>endobj10176 0 obj<</CreationDate(D:20100112101216Z)/Rect[234.44 298.522 251.231 308.235]/NM(8f28efa0-af90-4633-91f8-7a54077f3499)/Subtype/StrikeOut/C[0.0 0.0 1.0]/F 132/M(D:20100225121059Z)/IT/StrikeOutTextEdit/P 10172 0 R/T(ARM_2009_Q4)/Subj(Cross-Out)/QuadPoints[237.015 307.695 248.656 307.695 237.015 299.062 248.656 299.062]/IRT 10178 0 R/RT/Group/Type/Annot/Popup 10177 0 R/AP<</N 17791 0 R>>>>endobj10177 0 obj<</Rect[540.0 187.695 720.0 307.695]/Subtype/Popup/Parent 10176 0 R/F 28/Open false/Type/Annot>>endobj10178 0 obj<</CreationDate(D:20100112101218Z)/Rect[245.093 298.577 252.228 304.391]/NM(4291c9b6-df86-435d-93cc-0bbeb5473540)/Subtype/Caret/C[0.0 0.0 1.0]/F 132/Contents(if IsSecure\(\) then NS else '1';)/IT/Replace/M(D:20100225121059Z)/P 10172 0 R/T(ARM_2009_Q4)/Subj(Replacement Text)/RC(<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:8.1.7" xfa:spec="2.0.2" ><p><span style="font-style:normal">if IsSecure\(\) then NS else '1';</span></p></body>)/RD[0.484436 0.484436 0.484436 0.484436]/Type/Annot/Popup 10179 0 R/AP<</N 17789 0 R>>>>endobj10179 0 obj<</Rect[540.0 183.906 720.0 303.906]/Subtype/Popup/Parent 10178 0 R/F 28/Open false/Type/Annot>>endobj10180 0 obj<</Length 1107/Filter/FlateDecode>>stream

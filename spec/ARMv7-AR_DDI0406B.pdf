9-8464-91aea36c8b38)/Subtype/StrikeOut/CA 0.505005/C[1.0 1.0 0.0]/F 132/M(D:20110712123437+01'00')/IT/StrikeOutTextEdit/P 446 0 R/T(ARM_2011_Q2)/Subj(Cross-Out)/QuadPoints[94.98 168.411 164.947 168.411 94.98 159.778 164.947 159.778 94.98 158.749 164.947 158.749 94.98 150.116 164.947 150.116 94.98 139.432 215.473 139.432 94.98 130.799 215.473 130.799 110.58 129.831 269.898 129.831 110.58 121.198 269.898 121.198 126.122 120.169 374.849 120.169 126.122 111.536 374.849 111.536 126.122 110.507 238.815 110.507 126.122 101.874 238.815 101.874 110.58 100.845 126.122 100.845 110.58 92.2115 126.122 92.2115 126.122 91.1826 234.915 91.1826 126.122 82.5493 234.915 82.5493]/IRT 451 0 R/RT/Group/Type/Annot/Popup 450 0 R/AP<</N 16572 0 R>>>>endobj451 0 obj<</CreationDate(D:20110201151002Z)/Rect[231.445 81.9262 238.535 87.7033]/NM(5d20a62b-c0bd-49ab-8140-fe87f826fc75)/Subtype/Caret/CA 0.505005/C[1.0 1.0 0.0]/F 132/Contents(// BranchWritePC\(\)\r// ===============\r\rBranchWritePC\(bits\(32\) address\)\r    if CurrentInstrSet\(\) == InstrSet_ARM then\r        if ArchVersion\(\) < 6 && address<1:0> != '00' then UNPREDICTABLE;\r        BranchTo\(address<31:2>:'00'\);\r    elsi\f CurrentInstrSet\(\) == InstrSet_Jazelle then\r        if JazelleAcceptsExecute\(\) then\r            BranchTo\(address<31:0>\);\r        else\r            newaddress = address;\r            newaddress<1:0> = UNKNOWN;\r            BranchTo\(newaddress\);\\r    else\r        BranchTo\(address<31:1>:'0'\);)/IT/Replace/M(D:20110712123437+01'00')/P 446 0 R/T(ARM_2011_Q2)/Subj(Replacement Text)/RC(<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:8.2.5" xfa:spec="2.0.2" ><p dir="ltr"><span dir="ltr" style="font-size:7.5pt;text-align:left;color:#000000;font-wei\ght:normal;font-style:normal">// BranchWritePC\(\)&#13;// ===============&#13;&#13;BranchWritePC\(bits\(32\) address\)&#13;    if CurrentInstrSet\(\) == InstrSet_ARM then&#13;        if ArchVersion\(\) &lt; 6 &amp;&amp; address&lt;1:0&gt; != '00' then UNP\REDICTABLE;&#13;        BranchTo\(address&lt;31:2&gt;:'00'\);&#13;    elsif CurrentInstrSet\(\) == InstrSet_Jazelle then&#13;        if JazelleAcceptsExecute\(\) then&#13;            BranchTo\(address&lt;31:0&gt;\);&#13;        else&#13;            newadd\ress = address;&#13;            newaddress&lt;1:0&gt; = UNKNOWN;&#13;            BranchTo\(newaddress\);&#13;    else&#13;        BranchTo\(address&lt;31:1&gt;:'0'\);</span></p></body>)/RD[0.481415 0.481415 0.481415 0.481415]/Type/Annot/Popup 452 0 R/AP<</N 16571 0 R>>>>endobj519 0 obj<</Rect[102.306 239.454 356.182 268.491]/CreationDate(D:20110315093942Z)/NM(32db04ca-1ef2-468b-a1f9-4c0d43c7b50f)/Subtype/StrikeOut/C[0.0 0.0 1.0]/F 132/IT/StrikeOutTextEdit/M(D:20110712123437+01'00')/P 516 0 R/T(ARM_2011_Q2)/Subj(Cross-Out)/QuadPoints[104.88 267.951 353.607 267.951 104.88 259.318 353.607 259.318 104.88 248.627 202.027 248.627 104.88 239.994 202.027 239.994]/IRT 521 0 R/RT/Group/Type/Annot/Popup 520 0 R/AP<</N 16578 0 R>>>>endobj521 0 obj<</Rect[198.53 239.519 205.524 245.217]/CreationDate(D:20110315093942Z)/NM(c4c18361-fdca-4062-8e5c-a731428593ec)/Subtype/Caret/C[0.0 0.0 1.0]/F 132/Contents(// The 64-bit extension register bank for Advanced SIMD and VFP.\r \rarray bits\(64\) _D[0..31];\r\r// Clone the 64-bit extension register bank to use as input to instruction pseudocode \r// to avoid read-after-write for Advanced SIMD and VFP operations.\r\\rarray bits\(64\) _Dclone[0..31];\r\r\r// Din[] - non-assignment form\r// ==================\r \rbits\(64\) Din[integer n]\r    assert n >= 0 && n <= 31;\r    if n >= 16 && VFPSmallRegisterBank\(\) then UNDEFINED;\r    return _Dclone[n];\r\r\r// Qin[] - \non-assignment form\r// ==================\r \rbits\(128\) Qin[integer n]\r    assert n >= 0 && n <= 15;\r    return Din[2*n+1]:Din[2*n];)/M(D:20110712123437+01'00')/IT/Replace/P 516 0 R/T(ARM_2011_Q2)/Subj(Replacement Text)/RC(<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:8.2.6" xfa:spec="2.0.2" ><p dir="ltr"><span dir="ltr" style="font-size:10.0pt;text-align:left;color:#000000;font-we\ight:normal;font-style:normal">// The 64-bit extension register bank for Advanced SIMD and VFP.&#13; &#13;array bits\(64\) _D[0..31];&#13;&#13;// Clone the 64-bit extension register bank to use as input to instruction pseudocode &#13;// to avoid read-afte\r-write for Advanced SIMD and VFP operations.&#13;&#13;array bits\(64\) _Dclone[0..31];&#13;&#13;&#13;// Din[] - non-assignment form&#13;// ==================&#13; &#13;bits\(64\) Din[integer n]&#13;    assert n &gt;= 0 &amp;&amp; n &lt;= 31;&#13;    if n\ &gt;= 16 &amp;&amp; VFPSmallRegisterBank\(\) then UNDEFINED;&#13;    return _Dclone[n];&#13;&#13;&#13;// Qin[] - non-assignment form&#13;// ==================&#13; &#13;bits\(128\) Qin[integer n]&#13;    assert n &gt;= 0 &amp;&amp; n &lt;= 15;&#13;    re\turn Din[2*n+1]:Din[2*n];</span></p></body>)/RD[0.474823 0.474823 0.474823 0.474823]/Type/Annot/Popup 522 0 R/AP<</N 16580 0 R>>>>endobj523 0 obj<</CreationDate(D:20110315094202Z)/Rect[460.217 242.449 480.217 260.449]/NM(67f322fe-39a8-4018-a03a-1c9aa637764a)/Subtype/Text/CA 0.505005/C[1.0 1.0 0.0]/F 156/Contents(The replacement pseudocode defines an additional array, _Dclone[], that _D[] can be copied to, to avoiding possible read-after-write errors in instruction processing pseudocode.\r\rIn addition, the function Din[] returns a Doubleword register from the arr\ay _Dclone[], and the function Qin[] returns a Quadword register from the array.)/M(D:20110712123437+01'00')/Name/Comment/P 516 0 R/T(ARM_2011_Q2)/Subj(Sticky Note)/RC(<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:8.2.6" xfa:spec="2.0.2" ><p dir="ltr"><span dir="ltr" style="font-size:10.0pt;text-align:left;color:#000000;font-we\ight:normal;font-style:normal">The replacement pseudocode defines an additional array, _Dclone[], that _D[] can be copied to, to avoiding possible read-after-write errors in instruction processing pseudocode.&#13;&#13;In addition, the function Din[] retur\ns a Doubleword register from the array _Dclone[], and the function Qin[] returns a Quadword register from the array.</span></p></body>)/Type/Annot/Popup 524 0 R/AP<</N 16579 0 R>>>>endobj539 0 obj<</CreationDate(D:20110216125016Z)/Rect[495.543 504.326 515.543 522.326]/NM(4e4c050f-aa7e-4c1c-b8d9-ae7eee02335b)/Subtype/Text/CA 0.505005/C[1.0 1.0 0.0]/F 156/Contents(The instructions that can operate on polynomials, VMUL and VMULL, operate only on the .P8 data type. However, VMULL produces a .P16 output.)/M(D:20110712123437+01'00')/Name/Comment/P 537 0 R/T(ARM_2011_Q2)/Subj(Sticky Note)/RC(<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:8.2.6" xfa:spec="2.0.2" ><p dir="ltr"><span dir="ltr" style="font-size:10.0pt;text-align:left;color:#000000;font-we\ight:normal;font-style:normal">The instructions that can operate on polynomials, VMUL and VMULL, operate only on the .P8 data type. However, VMULL produces a .P16 output.</span></p></body>)/Type/Annot/Popup 540 0 R/AP<</N 16584 0 R>>>>endobj541 0 obj<</CreationDate(D:20110218154045Z)/Rect[419.628 506.15 441.211 516.35]/NM(b03d395e-225d-4f7d-b2d5-8c67207c025e)/Subtype/Highlight/CA 0.505005/C[1.0 1.0 0.0]/F 132/Contents(See marginal note.)/M(D:20110712123437+01'00')/P 537 0 R/T(ARM_2011_Q2)/Subj(Highlight)/QuadPoints[422.191 516.05 438.648 516.05 422.191 506.45 438.648 506.45]/RC(<?xml version="1.0"?><body xmlns="http://www.w3.org/1999/xhtml" xmlns:xfa="http://www.xfa.org/schema/xfa-data/1.0/" xfa:APIVersion="Acrobat:8.2.6" xfa:spec="2.0.2" ><p dir="ltr"><span dir="ltr" style="font-size:10.0pt;text-align:left;color:#000000;font-we\ight:normal;font-s